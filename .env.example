# Gateway auth token used by Claude Code as ANTHROPIC_AUTH_TOKEN.
GATEWAY_API_KEYS=local-dev-token

# Admin UI login is validated on the server. Prefer ADMIN_PASSWORD_HASH in production.
# Generate a hash locally:
# python -c "from claude_gateway.security import hash_password; print(hash_password('change-me'))"
ADMIN_USERNAME=reidelas
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=120
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_HOSTS=*
ADMIN_TRUSTED_IPS=177.200.246.8
TRUST_PROXY_HEADERS=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# OpenRouter token used by the gateway when calling upstream.
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter Anthropic-compatible base.
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Optional ChatGPT/OpenAI helper. If OPENAI_API_KEY is set, customer/admin
# frontend and strongest runs can use a cheap OpenAI model as a design director.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HELPER_MODEL=gpt-5.4-mini
OPENAI_HELPER_MAX_OUTPUT_TOKENS=900
OPENAI_HELPER_REASONING_EFFORT=low
OPENAI_HELPER_FOR_CUSTOMERS=true
ENABLE_OPENAI_DESIGN_DIRECTOR=true
ENABLE_OPENAI_DECISION_DIRECTOR=true

# Public model names exposed by GET /v1/models.
ECONOMY_PUBLIC_MODEL=claude-code-economy
PRO_PUBLIC_MODEL=claude-code-pro
ULTRA_PUBLIC_MODEL=claude-code-ultra
UI_PUBLIC_MODEL=claude-code-ui
AUTO_PUBLIC_MODEL=claude-code-auto

# Internal OpenRouter models. These defaults were verified against OpenRouter on 2026-05-18.
ROUTER_AGENT=tencent/hy3-preview
CHEAP_CODE_AGENT=deepseek/deepseek-v4-flash
CODE_AGENT=qwen/qwen3-coder-next
REASONING_AGENT=deepseek/deepseek-v4-pro
UI_AGENT=qwen/qwen3-coder-next
FAST_AGENT=deepseek/deepseek-v4-flash
PREMIUM_FALLBACK=moonshotai/kimi-k2.6
ULTRA_FALLBACK=qwen/qwen3-235b-a22b-thinking-2507
FRONTEND_CODER_AGENT=qwen/qwen3-coder-next
FRONTEND_FIX_AGENT=deepseek/deepseek-v4-flash
FRONTEND_REASONING_AGENT=tencent/hy3-preview
BACKEND_PARTNER_AGENT=moonshotai/kimi-k2.6
PROJECT_REASONING_AGENT=qwen/qwen3-235b-a22b-thinking-2507
DEEP_REASONING_AGENT=deepseek/deepseek-r1
GEMINI_CODE_HELPER_AGENT=google/gemini-2.5-flash-lite
ENABLE_GEMINI_CODE_HELPER=true

# Multi-agent orchestration is skipped automatically for streaming/tool calls.
ENABLE_AGENT_ORCHESTRATION=true

# Budget guard. 0.50 means the default internal paths must be at least 50% cheaper
# than Claude Opus 4.7 on blended input/output token price.
MAX_COST_RATIO_VS_CLAUDE=0.50
ALLOW_PREMIUM_FALLBACK=false
ALLOW_DIRECT_EXTERNAL_MODELS=false

# Hard request limits. These are enforced before the upstream API call.
MAX_REQUEST_INPUT_CHARS=120000
MAX_REQUEST_OUTPUT_TOKENS=16000
TOOL_REQUEST_OUTPUT_TOKENS=16000

# Optional paid customer API tokens, enforced server-side.
# Format:
# token|customer_name|monthly_price_brl|daily_token_limit|allowed_public_model|active;
# Example:
# CUSTOMER_ACCOUNTS=cus_live_abc|Cliente|149.90|60000|claude-code-pro|true
CUSTOMER_ACCOUNTS=
QUOTA_DATA_FILE=data/gateway.sqlite3
ACCOUNT_DATA_FILE=data/gateway.sqlite3
CUSTOMER_PROFIT_MARGIN=0.50
USD_TO_BRL=5.50
COST_RESERVE_MULTIPLIER=2.0

# MCP tools are localhost-only by default and write/command tools are opt-in.
MCP_WORKSPACE_ROOT=.
MCP_GATEWAY_BASE_URL=http://127.0.0.1:8787
MCP_GATEWAY_TOKEN=local-dev-token
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ENABLE_WRITE_TOOLS=false
MCP_ENABLE_COMMANDS=false

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost:8787
OPENROUTER_APP_NAME=Claude Code
