# Gateway auth token used by Claude Code as ANTHROPIC_AUTH_TOKEN.
GATEWAY_API_KEYS=local-dev-token

# OpenRouter token used by the gateway when calling upstream.
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter Anthropic-compatible base.
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Optional ChatGPT/OpenAI helper. If OPENAI_API_KEY is set, admin non-streaming
# agent runs can use OpenAI as an extra reviewer before the final answer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HELPER_MODEL=gpt-5-mini
OPENAI_HELPER_MAX_OUTPUT_TOKENS=900
OPENAI_HELPER_REASONING_EFFORT=low
OPENAI_HELPER_FOR_CUSTOMERS=false

# Public model names exposed by GET /v1/models.
ECONOMY_PUBLIC_MODEL=claude-code-economy
PRO_PUBLIC_MODEL=claude-code-pro
ULTRA_PUBLIC_MODEL=claude-code-ultra
UI_PUBLIC_MODEL=claude-code-ui
AUTO_PUBLIC_MODEL=claude-code-auto

# Internal OpenRouter models. These defaults were verified against OpenRouter on 2026-05-17.
ROUTER_AGENT=tencent/hy3-preview
CHEAP_CODE_AGENT=deepseek/deepseek-v4-flash
CODE_AGENT=deepseek/deepseek-v4-pro
REASONING_AGENT=deepseek/deepseek-v4-pro
UI_AGENT=moonshotai/kimi-k2.6
FAST_AGENT=stepfun/step-3.5-flash
PREMIUM_FALLBACK=moonshotai/kimi-k2.6
ULTRA_FALLBACK=deepseek/deepseek-v4-pro

# Multi-agent orchestration is skipped automatically for streaming/tool calls.
ENABLE_AGENT_ORCHESTRATION=true

# Budget guard. 0.50 means the default internal paths must be at least 50% cheaper
# than Claude Opus 4.7 on blended input/output token price.
MAX_COST_RATIO_VS_CLAUDE=0.50
ALLOW_PREMIUM_FALLBACK=false
ALLOW_DIRECT_EXTERNAL_MODELS=false

# Hard request limits. These are enforced before the upstream API call.
MAX_REQUEST_INPUT_CHARS=120000
MAX_REQUEST_OUTPUT_TOKENS=4096

# Optional paid customer API tokens, enforced server-side.
# Format:
# token|customer_name|monthly_price_brl|daily_token_limit|allowed_public_model|active;
# Example:
# CUSTOMER_ACCOUNTS=cus_live_abc|Cliente|149.90|60000|claude-code-pro|true
CUSTOMER_ACCOUNTS=
QUOTA_DATA_FILE=data/customer_usage.json
ACCOUNT_DATA_FILE=data/accounts.json
CUSTOMER_PROFIT_MARGIN=0.50
USD_TO_BRL=5.50
COST_RESERVE_MULTIPLIER=2.0

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost:8787
OPENROUTER_APP_NAME=Claude Code
