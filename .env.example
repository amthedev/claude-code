# Gateway auth token used by Claude Code as ANTHROPIC_AUTH_TOKEN.
GATEWAY_API_KEYS=local-dev-token
ALLOW_ADMIN_MODEL_ACCESS=false

# Admin UI login is validated on the server. Prefer ADMIN_PASSWORD_HASH in production.
# Generate a hash locally:
# python -c "from claude_gateway.security import hash_password; print(hash_password('change-me'))"
ADMIN_USERNAME=reidelas
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=600
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_HOSTS=*
ADMIN_TRUSTED_IPS=177.200.246.8
TRUST_PROXY_HEADERS=true
CORS_ALLOWED_ORIGINS=https://your-subdomain.squareweb.app,http://127.0.0.1:8787,http://localhost:8787
EXPOSE_OPENAPI=false
EXPOSE_DETAILED_HEALTH=false

# Primary VPS Anthropic-compatible model provider.
VPS_MODEL_BASE_URL=http://127.0.0.1:8000
VPS_MODEL_ID=local-model
VPS_MODEL_API_FORMAT=anthropic
VPS_MODEL_API_KEY=
VPS_MODEL_TIMEOUT_SECONDS=55
VPS_MODEL_SLOW_FALLBACK_SECONDS=6
VPS_DISABLE_QWEN_THINKING=true
SIMPLE_REQUEST_MAX_OUTPUT_TOKENS=768

# Optional same-GPU dual model setup. Run two vLLM processes in the same pod:
# fast model on 8000 for simple/cheap requests, strong model on 8001 for
# code, debugging, architecture, review, and explicit strong reasoning.
VPS_FAST_MODEL_BASE_URL=
VPS_FAST_MODEL_ID=qwen25-coder-14b
VPS_FAST_MODEL_API_FORMAT=
VPS_FAST_MODEL_API_KEY=
VPS_STRONG_MODEL_BASE_URL=
VPS_STRONG_MODEL_ID=
VPS_STRONG_MODEL_API_FORMAT=
VPS_STRONG_MODEL_API_KEY=

# RunPod account API key used only to start/stop the Pod from the admin panel.
# This is not the vLLM API key. The vLLM key is commonly sk-[pod-id] and belongs in VPS_MODEL_API_KEY.
RUNPOD_API_KEY=
RUNPOD_POD_ID=

# Mercado Pago server credentials. Keep both values only in backend/GitHub/Square Cloud secrets.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=600
MERCADO_PAGO_PUBLIC_URL=https://your-subdomain.squareweb.app

# OpenRouter fallback is disabled for production. Keep this false to avoid OpenRouter credits.
OPENROUTER_EMERGENCY_FALLBACK=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Optional ChatGPT/OpenAI helper. If OPENAI_API_KEY is set, customer/admin
# frontend and strongest runs can use a cheap OpenAI model as a design director.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HELPER_MODEL=gpt-5.4-mini
OPENAI_HELPER_MAX_OUTPUT_TOKENS=900
OPENAI_HELPER_REASONING_EFFORT=low
ENABLE_OPENAI_DESIGN_DIRECTOR=true
ENABLE_OPENAI_DECISION_DIRECTOR=true
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MODEL=gpt-5.5
WEB_SEARCH_CONTEXT_SIZE=low
WEB_SEARCH_FOR_CUSTOMERS=true
WEB_SEARCH_MAX_OUTPUT_TOKENS=900
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_BLOCKED_DOMAINS=

# Public model names exposed by GET /v1/models.
ECONOMY_PUBLIC_MODEL=claude-code-pro
PRO_PUBLIC_MODEL=claude-code-pro
ULTRA_PUBLIC_MODEL=claude-code-pro
UI_PUBLIC_MODEL=claude-code-pro
AUTO_PUBLIC_MODEL=claude-code-pro

# Internal routing model names are fixed in code. Do not set legacy
# ROUTER_AGENT / DEEP_REASONING_AGENT / KIMI / R1 env overrides here.

# Multi-agent orchestration is skipped for tool calls and simple requests.
ENABLE_AGENT_ORCHESTRATION=true

# Budget guard. 0.50 means the default internal paths must be at least 50% cheaper
# than Claude Opus 4.7 on blended input/output token price.
MAX_COST_RATIO_VS_CLAUDE=0.50
ALLOW_PREMIUM_FALLBACK=false
ALLOW_DIRECT_EXTERNAL_MODELS=false

# Hard request limits. These are enforced before the upstream API call.
MAX_REQUEST_INPUT_CHARS=120000
MAX_REQUEST_OUTPUT_TOKENS=16000
TOOL_REQUEST_OUTPUT_TOKENS=16000

# Optional paid customer API tokens, enforced server-side.
# Format:
# token|customer_name|monthly_price_brl|daily_token_limit|allowed_public_model|active;
# Example:
# CUSTOMER_ACCOUNTS=cus_live_abc|Cliente|149.90|60000|claude-code-pro|true
CUSTOMER_ACCOUNTS=
QUOTA_DATA_FILE=data/gateway.sqlite3
ACCOUNT_DATA_FILE=data/gateway.sqlite3

# Temporary public QA trial. Keep disabled by default and set END_AT in UTC/ISO.
PUBLIC_TRIAL_ENABLED=false
PUBLIC_TRIAL_END_AT=
PUBLIC_TRIAL_PLAN_ID=ultra
PUBLIC_TRIAL_DAILY_LIMIT=1200000
PUBLIC_TRIAL_LABEL=Teste grátis 24h

# Paid plans reserve at most 50% of the customer's payment for API cost.
CUSTOMER_PROFIT_MARGIN=0.50
USD_TO_BRL=5.50
COST_RESERVE_MULTIPLIER=2.0

# MCP tools are localhost-only by default and write/command tools are opt-in.
MCP_WORKSPACE_ROOT=.
MCP_GATEWAY_BASE_URL=http://127.0.0.1:8787
MCP_GATEWAY_TOKEN=local-dev-token
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ENABLE_WRITE_TOOLS=false
MCP_ENABLE_COMMANDS=false

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost:8787
OPENROUTER_APP_NAME=Claude Code
